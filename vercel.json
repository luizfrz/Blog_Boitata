{
  "version": 2,
  "installCommand": "echo 'sem install de node: o css ja esta em public/css'",
  "buildCommand": "echo 'sem build: o css ja esta em public/css'",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.4" }
  },
  "routes": [
    { "src": "/(css|js|img)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
